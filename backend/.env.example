# DBCopilot Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# URL of the Next.js frontend (used for CORS)
FRONTEND_ORIGIN=http://localhost:3001

# ─── MySQL Database (used for demo/development) ───────────────────────────────
# These are the credentials the server uses when testing the connection endpoint.
# At runtime, credentials are submitted by the user through the UI.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# ─── AI Providers ────────────────────────────────────────────────────────────
# Option 1: Groq (RECOMMENDED — 100% Free, Blazing Fast ~0.4s, 14,400 calls/day)
# Get a free key without credit card at https://console.groq.com
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (Free Tier)
# Obtain your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Option 3: Ollama (100% Local, Offline & Free Forever)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b

